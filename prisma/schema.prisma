generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ORG_ADMIN
  FARM_MANAGER
  OPERATIONS_MANAGER
  AGRONOMIST
  LIVESTOCK_MANAGER
  ACCOUNTANT
  PROCUREMENT_OFFICER
  STOREKEEPER
  SALES_OFFICER
  FIELD_SUPERVISOR
  FIELD_WORKER
  AUDITOR
  VIEWER
}

enum FarmType {
  CROP
  LIVESTOCK
  POULTRY
  AQUACULTURE
  MIXED
  GREENHOUSE
  ORCHARD
  OTHER
}

enum UnitType {
  FIELD
  PLOT
  GREENHOUSE
  ORCHARD
  BARN
  PEN
  POULTRY_HOUSE
  POND
  TANK
  GRAZING_AREA
  NURSERY
  PROCESSING_AREA
  WAREHOUSE_AREA
  OTHER
}

enum CycleType {
  CROP
  LIVESTOCK
  POULTRY
  AQUACULTURE
  OTHER
}

enum CycleStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InventoryTxnType {
  OPENING
  PURCHASE
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PRODUCTION
  SALE
  RETURN
  WASTE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  VOID
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  CULLED
  TRANSFERRED
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
  SOLD
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CropActivityType {
  LAND_PREPARATION
  PLANTING
  IRRIGATION
  FERTILIZATION
  SPRAYING
  WEEDING
  SCOUTING
  HARVEST
  OTHER
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ObservationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LivestockEventType {
  WEIGHT
  VACCINATION
  TREATMENT
  DEWORMING
  DIAGNOSIS
  BREEDING
  PREGNANCY_CHECK
  BIRTH
  OTHER
}

enum RevenueType {
  HARVEST_SALE
  LIVESTOCK_SALE
  MILK
  EGGS
  FISH_SALE
  SERVICE
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  INVOICED
  CANCELLED
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACTOR
  SEASONAL
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum EquipmentLogType {
  USAGE
  FUEL
  MAINTENANCE
  BREAKDOWN
  INSPECTION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  memberships  Membership[]
  tasksCreated Task[]       @relation("TaskCreator")
  tasksAssigned Task[]      @relation("TaskAssignee")
  auditLogs    AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Tenant {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  currency       String                 @default("NGN")
  timezone       String                 @default("Africa/Lagos")
  memberships    Membership[]
  farms          Farm[]
  units          ProductionUnit[]
  cycles         ProductionCycle[]
  tasks          Task[]
  warehouses     Warehouse[]
  products       Product[]
  inventoryTxns  InventoryTransaction[]
  expenses       Expense[]
  animals        Animal[]
  equipment      Equipment[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  cropActivities CropActivity[]
  scoutingObservations ScoutingObservation[]
  harvestRecords HarvestRecord[]
  revenues       Revenue[]
  vendors        Vendor[]
  purchaseRequests PurchaseRequest[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  animalHealthEvents AnimalHealthEvent[]
  poultryDailyRecords PoultryDailyRecord[]
  aquacultureRecords AquacultureRecord[]
  customers      Customer[]
  salesOrders    SalesOrder[]
  salesOrderItems SalesOrderItem[]
  workforceMembers WorkforceMember[]
  timesheets     Timesheet[]
  equipmentLogs  EquipmentLog[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(VIEWER)
  farmScope String[] @default([])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
}

model Farm {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  type        FarmType         @default(MIXED)
  country     String?
  state       String?
  address     String?
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  areaHa      Decimal?         @db.Decimal(12, 3)
  active      Boolean          @default(true)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units       ProductionUnit[]
  cycles      ProductionCycle[]
  tasks       Task[]
  warehouses  Warehouse[]
  expenses    Expense[]
  animals     Animal[]
  equipment   Equipment[]
  cropActivities CropActivity[]
  scoutingObservations ScoutingObservation[]
  harvestRecords HarvestRecord[]
  revenues    Revenue[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  workforceMembers WorkforceMember[]
  timesheets Timesheet[]
  equipmentLogs EquipmentLog[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProductionUnit {
  id          String            @id @default(cuid())
  tenantId    String
  farmId      String
  name        String
  code        String?
  type        UnitType          @default(FIELD)
  areaHa      Decimal?          @db.Decimal(12, 3)
  geometryGeoJson Json?
  active      Boolean           @default(true)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cycles      ProductionCycle[]
  tasks       Task[]
  animals     Animal[]
  equipment   Equipment[]
  cropActivities CropActivity[]
  scoutingObservations ScoutingObservation[]
  harvestRecords HarvestRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([farmId, name])
  @@index([tenantId, farmId])
}

model ProductionCycle {
  id             String       @id @default(cuid())
  tenantId       String
  farmId         String
  unitId         String?
  name           String
  type           CycleType
  commodity      String
  variety        String?
  status         CycleStatus  @default(PLANNED)
  startDate      DateTime?
  expectedEndDate DateTime?
  actualEndDate  DateTime?
  targetQuantity Decimal?     @db.Decimal(14, 3)
  targetUnit     String?
  budgetAmount   Decimal?     @db.Decimal(16, 2)
  notes          String?
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  unit           ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tasks          Task[]
  inventoryTxns  InventoryTransaction[]
  expenses       Expense[]
  cropActivities CropActivity[]
  scoutingObservations ScoutingObservation[]
  harvestRecords HarvestRecord[]
  revenues       Revenue[]
  poultryDailyRecords PoultryDailyRecord[]
  aquacultureRecords AquacultureRecord[]
  salesOrders    SalesOrder[]
  timesheets     Timesheet[]
  equipmentLogs  EquipmentLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([farmId])
}

model Task {
  id          String        @id @default(cuid())
  tenantId    String
  farmId      String?
  unitId      String?
  cycleId     String?
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueAt       DateTime?
  createdById String
  assignedToId String?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  unit        ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo  User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Warehouse {
  id          String      @id @default(cuid())
  tenantId    String
  farmId      String?
  name        String
  code        String?
  active      Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?       @relation(fields: [farmId], references: [id], onDelete: SetNull)
  inventoryTxns InventoryTransaction[]
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, name])
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  sku         String?
  category    String
  unit        String
  reorderLevel Decimal?   @db.Decimal(14, 3)
  standardCost Decimal?   @db.Decimal(16, 4)
  active      Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryTxns InventoryTransaction[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems SalesOrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, sku])
}

model InventoryTransaction {
  id          String           @id @default(cuid())
  tenantId    String
  warehouseId String
  productId   String
  cycleId     String?
  type        InventoryTxnType
  quantity    Decimal          @db.Decimal(14, 3)
  unitCost    Decimal?         @db.Decimal(16, 4)
  lotNumber   String?
  reference   String?
  notes       String?
  occurredAt  DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([tenantId, productId])
  @@index([warehouseId, productId])
}

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  farmId      String?
  cycleId     String?
  category    String
  description String
  amount      Decimal       @db.Decimal(16, 2)
  status      ExpenseStatus @default(DRAFT)
  incurredAt  DateTime      @default(now())
  vendor      String?
  reference   String?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?         @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, incurredAt])
}

model Animal {
  id          String       @id @default(cuid())
  tenantId    String
  farmId      String
  unitId      String?
  tag         String
  species     String
  breed       String?
  sex         String?
  birthDate   DateTime?
  status      AnimalStatus @default(ACTIVE)
  notes       String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  unit        ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  healthEvents AnimalHealthEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, tag])
  @@index([farmId, status])
}

model Equipment {
  id          String          @id @default(cuid())
  tenantId    String
  farmId      String?
  unitId      String?
  name        String
  code        String?
  category    String
  status      EquipmentStatus @default(AVAILABLE)
  purchaseDate DateTime?
  purchaseValue Decimal?      @db.Decimal(16, 2)
  meterReading Decimal?       @db.Decimal(14, 2)
  meterUnit   String?
  nextServiceAt Decimal?      @db.Decimal(14, 2)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?           @relation(fields: [farmId], references: [id], onDelete: SetNull)
  unit        ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  logs        EquipmentLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, name])
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  role        Role
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([tenantId, email])
}

model CropActivity {
  id          String           @id @default(cuid())
  tenantId    String
  farmId      String
  unitId      String?
  cycleId     String
  type        CropActivityType
  title       String
  status      ActivityStatus   @default(PLANNED)
  plannedAt   DateTime?
  completedAt DateTime?
  areaHa      Decimal?         @db.Decimal(12, 3)
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  unit        ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, status])
  @@index([cycleId, plannedAt])
}

model ScoutingObservation {
  id             String              @id @default(cuid())
  tenantId       String
  farmId         String
  unitId         String?
  cycleId        String?
  observedAt     DateTime            @default(now())
  category       String
  issue          String
  severity       ObservationSeverity @default(MEDIUM)
  affectedAreaHa Decimal?            @db.Decimal(12, 3)
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  recommendation String?
  photoUrl       String?
  resolvedAt     DateTime?
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  unit           ProductionUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cycle          ProductionCycle?    @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, severity])
  @@index([farmId, observedAt])
}

model HarvestRecord {
  id          String           @id @default(cuid())
  tenantId    String
  farmId      String
  unitId      String?
  cycleId     String
  quantity    Decimal          @db.Decimal(14, 3)
  unit        String
  grade       String?
  lotNumber   String?
  harvestedAt DateTime         @default(now())
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  productionUnit ProductionUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([tenantId, harvestedAt])
  @@index([cycleId])
}

model Revenue {
  id          String      @id @default(cuid())
  tenantId    String
  farmId      String?
  cycleId     String?
  type        RevenueType @default(OTHER)
  description String
  amount      Decimal     @db.Decimal(16, 2)
  occurredAt  DateTime    @default(now())
  customer    String?
  reference   String?
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?       @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId, occurredAt])
}

model Vendor {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  email       String?
  phone       String?
  address     String?
  active      Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, name])
}

model PurchaseRequest {
  id          String            @id @default(cuid())
  tenantId    String
  farmId      String?
  requestNo   String
  title       String
  status      ProcurementStatus @default(DRAFT)
  neededBy    DateTime?
  notes       String?
  requestedById String
  approvedAt  DateTime?
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?             @relation(fields: [farmId], references: [id], onDelete: SetNull)
  items       PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([tenantId, requestNo])
  @@index([tenantId, status])
}

model PurchaseRequestItem {
  id          String          @id @default(cuid())
  tenantId    String
  requestId   String
  productId   String?
  description String
  quantity    Decimal         @db.Decimal(14, 3)
  unit        String
  estimatedUnitCost Decimal?  @db.Decimal(16, 4)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String
  farmId      String?
  vendorId    String
  requestId   String?
  warehouseId String?
  orderNo     String
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now())
  expectedAt  DateTime?
  notes       String?
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?               @relation(fields: [farmId], references: [id], onDelete: SetNull)
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  request     PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  tenantId    String
  purchaseOrderId String
  productId   String?
  description String
  quantity    Decimal       @db.Decimal(14, 3)
  unit        String
  unitPrice   Decimal       @db.Decimal(16, 4)
  receivedQty Decimal       @default(0) @db.Decimal(14, 3)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
}

model AnimalHealthEvent {
  id          String             @id @default(cuid())
  tenantId    String
  animalId    String
  type        LivestockEventType
  eventDate   DateTime           @default(now())
  title       String
  details     String?
  weightKg    Decimal?           @db.Decimal(10, 3)
  medication  String?
  dosage      String?
  veterinarian String?
  nextDueAt   DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  animal      Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  @@index([tenantId, eventDate])
  @@index([animalId, eventDate])
}

model PoultryDailyRecord {
  id          String          @id @default(cuid())
  tenantId    String
  cycleId     String
  recordDate  DateTime
  openingBirds Int?
  mortality   Int             @default(0)
  culls       Int             @default(0)
  feedKg      Decimal?        @db.Decimal(12, 3)
  waterLiters Decimal?        @db.Decimal(12, 3)
  eggs        Int?
  avgWeightKg Decimal?        @db.Decimal(10, 3)
  notes       String?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle       ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([cycleId, recordDate])
  @@index([tenantId, recordDate])
}

model AquacultureRecord {
  id          String          @id @default(cuid())
  tenantId    String
  cycleId     String
  recordDate  DateTime
  sampleSize  Int?
  avgWeightG  Decimal?        @db.Decimal(12, 3)
  mortality   Int             @default(0)
  feedKg      Decimal?        @db.Decimal(12, 3)
  ph          Decimal?        @db.Decimal(5, 2)
  dissolvedOxygen Decimal?    @db.Decimal(6, 2)
  temperatureC Decimal?       @db.Decimal(6, 2)
  notes       String?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle       ProductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([cycleId, recordDate])
  @@index([tenantId, recordDate])
}

model Customer {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  email       String?
  phone       String?
  address     String?
  active      Boolean     @default(true)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, name])
}

model SalesOrder {
  id          String           @id @default(cuid())
  tenantId    String
  farmId      String?
  cycleId     String?
  customerId  String
  warehouseId String?
  orderNo     String
  status      SalesOrderStatus @default(DRAFT)
  orderDate   DateTime         @default(now())
  deliveryDate DateTime?
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items       SalesOrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
}

model SalesOrderItem {
  id          String      @id @default(cuid())
  tenantId    String
  salesOrderId String
  productId   String?
  description String
  quantity    Decimal     @db.Decimal(14, 3)
  unit        String
  unitPrice   Decimal     @db.Decimal(16, 4)
  fulfilledQty Decimal    @default(0) @db.Decimal(14, 3)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder  SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([salesOrderId])
}

model WorkforceMember {
  id          String         @id @default(cuid())
  tenantId    String
  farmId      String?
  employeeNo  String?
  name        String
  phone       String?
  jobTitle    String?
  employmentType EmploymentType @default(PERMANENT)
  defaultHourlyRate Decimal? @db.Decimal(16, 4)
  active      Boolean        @default(true)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  farm        Farm?          @relation(fields: [farmId], references: [id], onDelete: SetNull)
  timesheets  Timesheet[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, employeeNo])
  @@index([tenantId, active])
}

model Timesheet {
  id          String          @id @default(cuid())
  tenantId    String
  workerId    String
  farmId      String?
  cycleId     String?
  workDate    DateTime
  hours       Decimal         @db.Decimal(8, 2)
  hourlyRate  Decimal         @db.Decimal(16, 4)
  activity    String
  status      TimesheetStatus @default(SUBMITTED)
  notes       String?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  worker      WorkforceMember @relation(fields: [workerId], references: [id], onDelete: Cascade)
  farm        Farm?           @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId, workDate])
  @@index([cycleId, status])
}

model EquipmentLog {
  id          String           @id @default(cuid())
  tenantId    String
  equipmentId String
  farmId      String?
  cycleId     String?
  type        EquipmentLogType
  logDate     DateTime         @default(now())
  hours       Decimal?         @db.Decimal(10, 2)
  fuelLiters  Decimal?         @db.Decimal(12, 3)
  cost        Decimal?         @db.Decimal(16, 2)
  meterReading Decimal?        @db.Decimal(14, 2)
  notes       String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment   Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  farm        Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cycle       ProductionCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([tenantId, logDate])
  @@index([equipmentId, logDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
